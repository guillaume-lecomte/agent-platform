# Copy to .env to override defaults. Everything works without any key: the default
# LLM provider is a deterministic mock.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Infrastructure (matches docker-compose.yml)
DATABASE_URL=postgres://agent:agent@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379

# LLM provider: mock (default) | anthropic | openai.
# A real provider is only used when selected here AND its key is set below.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Folder with pricing.yaml and the routing policy, and the policy file inside it.
CONFIG_DIR=./config
ROUTER_POLICY=routing.yaml

# Adds a real delay (ms) to every mock LLM call, to make long tasks observable.
MOCK_DELAY_MS=0

# Optional OpenTelemetry export; tracing is disabled when empty.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Tests use a separate database (created by docker/postgres-init.sql):
#   DATABASE_URL=postgres://agent:agent@localhost:5432/agent_platform_test pnpm test
